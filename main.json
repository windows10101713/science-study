{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "9826480513159038843"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastasia",
      "metadata": {
        "description": "Azure region for the resource group and Static Web App."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-science-study-dev-ee47",
      "metadata": {
        "description": "Deployment resource group name from the approved plan."
      }
    },
    "staticWebAppName": {
      "type": "string",
      "defaultValue": "swa-science-study-dev-ee47",
      "metadata": {
        "description": "Static Web App name from the approved plan."
      }
    },
    "deployedBy": {
      "type": "string",
      "defaultValue": "김유준",
      "metadata": {
        "description": "Person or automation identity that initiated the deployment."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2022-09-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": {
        "appOnboardSkill": "true",
        "deployedBy": "[parameters('deployedBy')]",
        "environment": "dev"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "staticWebAppDeployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "staticWebAppName": {
            "value": "[parameters('staticWebAppName')]"
          },
          "deployedBy": {
            "value": "[parameters('deployedBy')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "2928089157221599772"
            }
          },
          "parameters": {
            "staticWebAppName": {
              "type": "string",
              "metadata": {
                "description": "Static Web App name from the approved plan."
              }
            },
            "deployedBy": {
              "type": "string",
              "metadata": {
                "description": "Person or automation identity that initiated the deployment."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('staticWebAppName')]",
              "location": "[resourceGroup().location]",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "properties": {
                "stagingEnvironmentPolicy": "Enabled"
              },
              "tags": {
                "appOnboardSkill": "true",
                "deployedBy": "[parameters('deployedBy')]",
                "environment": "dev"
              }
            }
          ],
          "outputs": {
            "staticWebAppName": {
              "type": "string",
              "value": "[parameters('staticWebAppName')]"
            },
            "defaultHostname": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('staticWebAppName')), '2023-12-01').defaultHostname]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "staticWebAppName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'staticWebAppDeployment'), '2025-04-01').outputs.staticWebAppName.value]"
    },
    "defaultHostname": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'staticWebAppDeployment'), '2025-04-01').outputs.defaultHostname.value]"
    }
  }
}