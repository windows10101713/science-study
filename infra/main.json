      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "cosmosAccountName": {
            "value": "[parameters('cosmosAccountName')]"
          },
          "deployedBy": {
            "value": "[parameters('deployedBy')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "662287310914691519"
            }
          },
          "parameters": {
            "cosmosAccountName": {
              "type": "string",
              "metadata": {
                "description": "Globally unique Cosmos DB account name."
              }
            },
            "deployedBy": {
              "type": "string",
              "metadata": {
                "description": "Person or automation identity that initiated the deployment."
