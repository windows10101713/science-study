        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "staticWebAppName": {
            "value": "[parameters('staticWebAppName')]"
          },
          "deployedBy": {
            "value": "[parameters('deployedBy')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "2928089157221599772"
            }
          },
          "parameters": {
            "staticWebAppName": {
              "type": "string",
              "metadata": {
