import { useState, useMemo } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { allQuestions } from '../data/questions'
import { allLessons } from '../data/lessons'
import { getCustomConcept } from '../lib/concepts'
import '../styles/index.css'

export default function QuizPage() {
  const { lessonId } = useParams()
  const navigate = useNavigate()
  const [currentQuestionIdx, setCurrentQuestionIdx] = useState(0)
  const [answers, setAnswers] = useState<Record<string, string>>({})
  const [submitted, setSubmitted] = useState(false)
  const [showExplanation, setShowExplanation] = useState(false)

  // 레슨 정보 가져오기
  const lesson = useMemo(() => {
    const custom = getCustomConcept(lessonId!)
    if (custom) return custom
    return allLessons.find(l => l.id === lessonId)
  }, [lessonId])

  // 이 레슨의 문제들 가져오기
  const questions = useMemo(() => {
    if (!lesson || !lesson.questions || lesson.questions.length === 0) {
      return []
    }
    return allQuestions.filter(q => lesson.questions.includes(q.id)).slice(0, 4)
  }, [lesson])

  // 선택지 섞기 (multiple_choice)
  const currentQuestion = questions[currentQuestionIdx]
  const isLastQuestion = questions.length > 0 && currentQuestionIdx === questions.length - 1
  const answered = currentQuestion && answers[currentQuestion.id] !== undefined

  if (!lesson || questions.length === 0) {
    return (
      <div className="app">
        <header className="header">
          <div className="container">
            <h1>문제 없음</h1>
            <p>이 개념에는 문제가 등록되지 않았습니다</p>
          </div>
        </header>
        <main className="container">
          <div className="card">
            <p style={{ textAlign: 'center', color: '#666' }}>
              학습을 완료한 후 다시 시도해주세요.
            </p>
            <button
              className="btn btn-primary"
              onClick={() => navigate('/')}
              style={{ width: '100%', marginTop: '1rem' }}
            >
              홈으로 돌아가기
            </button>
          </div>
        </main>
      </div>
    )
  }

  const handleAnswer = (answer: string) => {
    setAnswers({ ...answers, [currentQuestion.id]: answer })
  }

  const handleSubmit = () => {
    if (!answered) return
    setSubmitted(true)
    setShowExplanation(true)
  }

  const handleNext = () => {
    if (isLastQuestion) {
      // 결과 계산
      const correctCount = questions.reduce((count, q) => {
        const userAnswer = answers[q.id]
        const correct = userAnswer === q.answer || 
                       (q.type === 'short_answer' && userAnswer?.includes(q.answer as string))
        return correct ? count + 1 : count
      }, 0)

      // 저장
      sessionStorage.setItem(`quiz_${lessonId}`, JSON.stringify({
        totalQuestions: questions.length,
        correctCount,
        answers,
        date: new Date().toISOString(),
      }))
      navigate(`/result/${lessonId}`)
    } else {
      setCurrentQuestionIdx(currentQuestionIdx + 1)
      setSubmitted(false)
      setShowExplanation(false)
    }
  }

  const progress = ((currentQuestionIdx + 1) / questions.length) * 100
  const isCorrect = currentQuestion.answer === answers[currentQuestion.id] ||
                   (currentQuestion.type === 'short_answer' && 
                    answers[currentQuestion.id]?.includes(currentQuestion.answer as string))

  return (
    <div className="app">
      <header className="header">
        <div className="container">
          <h1>❓ 문제 풀이</h1>
          <p>{lesson.title}</p>
        </div>
      </header>

      <main className="container">
        <div style={{ marginBottom: '1.5rem' }}>
          <p style={{ marginBottom: '0.5rem', fontWeight: 'bold' }}>
            문제 {currentQuestionIdx + 1} / {questions.length}
          </p>
          <div className="progress-bar">
            <div className="progress-fill" style={{ width: `${progress}%` }}></div>
          </div>
        </div>

        <div className="card">
          <h3 style={{ marginBottom: '1.5rem' }}>{currentQuestion.question}</h3>

          {currentQuestion.type === 'multiple_choice' && (
            <div style={{ display: 'grid', gap: '0.75rem', marginBottom: '1.5rem' }}>
              {currentQuestion.options?.map((option, idx) => (
                <label
                  key={idx}
                  style={{
                    cursor: 'pointer',
                    padding: '1rem',
                    border: answers[currentQuestion.id] === option
                      ? `2px solid ${submitted && isCorrect ? '#10b981' : submitted && !isCorrect ? '#ef4444' : '#667eea'}`
                      : '2px solid #e0e7ff',
                    borderRadius: '0.5rem',
                    backgroundColor: answers[currentQuestion.id] === option
                      ? submitted && isCorrect ? '#f0fdf4' : submitted && !isCorrect ? '#fef2f2' : '#f0f4ff'
                      : 'white',
                    transition: 'all 0.2s'
                  }}
                >
                  <input
                    type="radio"
                    name="answer"
                    value={option}
                    checked={answers[currentQuestion.id] === option}
                    onChange={() => !submitted && handleAnswer(option)}
                    disabled={submitted}
                    style={{ marginRight: '0.75rem' }}
                  />
                  <span>{option}</span>
                  {submitted && answers[currentQuestion.id] === option && (
                    <span style={{ marginLeft: '0.5rem' }}>
                      {isCorrect ? '✓ 정답' : '✗ 오답'}
                    </span>
                  )}
                </label>
              ))}
            </div>
          )}

          {currentQuestion.type === 'short_answer' && (
            <div style={{ marginBottom: '1.5rem' }}>
              <input
                type="text"
                value={answers[currentQuestion.id] || ''}
                onChange={(e) => !submitted && handleAnswer(e.target.value)}
                disabled={submitted}
                placeholder="정답을 입력하세요"
                style={{ width: '100%', marginBottom: '1rem' }}
              />
              {submitted && (
                <div style={{
                  padding: '1rem',
                  borderRadius: '0.5rem',
                  backgroundColor: isCorrect ? '#f0fdf4' : '#fef2f2',
                  border: `2px solid ${isCorrect ? '#10b981' : '#ef4444'}`
                }}>
                  <p style={{ color: isCorrect ? '#10b981' : '#ef4444', fontWeight: 'bold' }}>
                    {isCorrect ? '✓ 정답입니다!' : `✗ 정답: ${currentQuestion.answer}`}
                  </p>
                </div>
              )}
            </div>
          )}

          {currentQuestion.type === 'calculation' && (
            <div style={{ marginBottom: '1.5rem' }}>
              <input
                type="text"
                value={answers[currentQuestion.id] || ''}
                onChange={(e) => !submitted && handleAnswer(e.target.value)}
                disabled={submitted}
                placeholder="숫자 또는 식을 입력하세요"
                style={{ width: '100%', marginBottom: '1rem' }}
              />
              {submitted && (
                <div style={{
                  padding: '1rem',
                  borderRadius: '0.5rem',
                  backgroundColor: isCorrect ? '#f0fdf4' : '#fef2f2',
                  border: `2px solid ${isCorrect ? '#10b981' : '#ef4444'}`
                }}>
                  <p style={{ color: isCorrect ? '#10b981' : '#ef4444', fontWeight: 'bold' }}>
                    {isCorrect ? '✓ 정답입니다!' : `✗ 정답: ${currentQuestion.answer}`}
                  </p>
                </div>
              )}
            </div>
          )}

          {showExplanation && (
            <div style={{
              padding: '1rem',
              backgroundColor: '#f9f7ff',
              border: '2px solid #e0d5ff',
              borderRadius: '0.5rem',
              marginBottom: '1.5rem'
            }}>
              <p style={{ fontWeight: 'bold', color: '#667eea', marginBottom: '0.5rem' }}>
                💡 설명
              </p>
              <p>{currentQuestion.explanation}</p>
            </div>
          )}

          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1rem' }}>
            {submitted ? (
              <>
                <button
                  className="btn btn-secondary"
                  onClick={() => navigate('/')}
                  style={{ width: '100%' }}
                >
                  ← 홈으로
                </button>
                <button
                  className="btn btn-primary"
                  onClick={handleNext}
                  style={{ width: '100%' }}
                >
                  {isLastQuestion ? '결과 보기 →' : '다음 문제 →'}
                </button>
              </>
            ) : (
              <button
                className="btn btn-primary"
                onClick={handleSubmit}
                disabled={!answered}
                style={{ width: '100%', gridColumn: '1 / -1', opacity: answered ? 1 : 0.5 }}
              >
                {answered ? '제출하기' : '답을 선택해주세요'}
              </button>
            )}
          </div>
        </div>
      </main>
    </div>
  )
}
